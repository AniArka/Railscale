<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
           http://maven.apache.org/POM/4.0.0
           https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>com.railscale</groupId>
    <artifactId>railscale-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>railscale-parent</name>
    <description>RailScale Distributed Ticketing System Parent POM</description>

    <modules>
        <module>railscale-common</module>
        <module>railscale-booking-service</module>
        <module>railscale-user-service</module>
        <module>railscale-search-service</module>
        <module>railscale-payment-service</module>
        <module>railscale-notification-service</module>
        <module>railscale-eureka-server</module>
        <module>railscale-api-gateway</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2024.0.0</spring-cloud.version>
        <railscale.version>0.0.1-SNAPSHOT</railscale.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.railscale</groupId>
                <artifactId>railscale-common</artifactId>
                <version>${railscale.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
