{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.4.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""}
  ],
  "annotations": {"list": []},
  "description": "RailScale booking system — domain metrics dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Booking Throughput",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "reqps"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
      "id": 1,
      "options": {"legend": {"calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom"}},
      "targets": [
        {
          "expr": "rate(booking_requests_total[1m])",
          "legendFormat": "Requests/s"
        },
        {
          "expr": "rate(booking_success_total[1m])",
          "legendFormat": "Success/s"
        },
        {
          "expr": "rate(booking_failure_total[1m])",
          "legendFormat": "Failure/s"
        }
      ],
      "title": "Booking Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "reqps"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1},
      "id": 2,
      "targets": [
        {
          "expr": "rate(seat_hold_total[1m])",
          "legendFormat": "Holds/s"
        },
        {
          "expr": "rate(seat_hold_expired_total[1m])",
          "legendFormat": "Hold Expirations/s"
        },
        {
          "expr": "rate(seat_contention_total[1m])",
          "legendFormat": "Contentions/s"
        }
      ],
      "title": "Seat Hold & Contention Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "reqps"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 1},
      "id": 3,
      "targets": [
        {
          "expr": "rate(refund_required_total[1m])",
          "legendFormat": "Refunds/s"
        },
        {
          "expr": "rate(kafka_publish_failures_total[1m])",
          "legendFormat": "Kafka Failures/s"
        }
      ],
      "title": "Refunds & Kafka Failures",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "id": 101,
      "title": "Live Gauges",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 500}, {"color": "red", "value": 1000}]},
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 10},
      "id": 4,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "active_holds", "legendFormat": "Active Holds"}],
      "title": "Active Seat Holds",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 10},
      "id": 5,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "confirmed_bookings", "legendFormat": "Confirmed Bookings"}],
      "title": "Confirmed Bookings (Total)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "id": 102,
      "title": "Latency",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "s"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 15},
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(booking_latency_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(booking_latency_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(booking_latency_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ],
      "title": "Booking Latency (p50/p95/p99)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "s"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 15},
      "id": 7,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(redis_operation_latency_seconds_bucket[5m]))",
          "legendFormat": "Redis p95"
        },
        {
          "expr": "histogram_quantile(0.95, rate(postgres_operation_latency_seconds_bucket[5m]))",
          "legendFormat": "Postgres p95"
        }
      ],
      "title": "Redis & Postgres Latency p95",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "id": 103,
      "title": "JVM",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "bytes"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "id": 8,
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\", job=\"booking-service\"}",
          "legendFormat": "Heap Used"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\", job=\"booking-service\"}",
          "legendFormat": "Heap Max"
        }
      ],
      "title": "booking-service JVM Heap",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "short"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "id": 9,
      "targets": [
        {
          "expr": "jvm_threads_live_threads{job=\"booking-service\"}",
          "legendFormat": "Live Threads"
        },
        {
          "expr": "jvm_threads_peak_threads{job=\"booking-service\"}",
          "legendFormat": "Peak Threads"
        }
      ],
      "title": "booking-service JVM Threads",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["railscale", "booking", "observability"],
  "templating": {
    "list": [
      {
        "current": {"selected": false, "text": "Prometheus", "value": "prometheus"},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "RailScale — Booking System",
  "uid": "railscale-booking",
  "version": 1
}
